                  </g>
                </svg>
              </div>
              <div>
                <p>Statystyki</p>
              </div>
            </div>
          </a>
        </section>
        <footer></footer>
      </center>
      <p class="user_count">
        Liczba wyświetleń strony: <span class="data_count"><%= count; %></span>
      </p>
      <p class="user_count live_count">
        Wyświetlenia na żywo:
        <span class="data_count"><b><%= live; %></b></span>
      </p>
    </main>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="/public/js/admin.dev.js"></script>
    
  </body>
</html>
